# Dependencies and package-manager caches. These were deliberately left out of the
# 2026-11-22 snapshot (see README) and are regenerated with `npm install`.
web-panel/node_modules/
web-panel/.npm/
web-panel/.wrangler/

# karucode's own per-agent checkout directory (subagent worktrees).
.karucode/

# Wrangler local secrets. Never committed; the live values live in relay/relay.env.
.dev.vars
**/.dev.vars

# Output of tools/compile-plugins.sh. Build artefacts must never be committed, and
# must never be written into the live game-server plugins/ tree.
tools/build/

# Python bytecode from `python3 -m py_compile web-panel/scripts/*.py`.
__pycache__/
*.pyc

# Operational credentials for tools/watch-server.py and tools/backup-pull.py:
# the Discord webhook and the two SFTP passwords. They live in
# ~/.config/freenova-watch/ (mode 600, outside this tree). Anything that looks
# like a copy of them is ignored by name so a stray `cp` cannot stage a secret.
freenova-watch/
*.pass
askpass.sh

# OS / editor noise.
.DS_Store
*.orig
*.rej
*.swp
*~

# NOTE: log files are deliberately NOT ignored. amxmodx/logs/*.log and
# web-panel/relay/relay.log are part of the snapshot, and the AMXX log files are
# the only record of runtime errors on the live server. Ignore a specific noisy
# file by name if one is added later; do not add a blanket *.log rule.

# Handover snapshot dropped into cstrike by the owner (2026-11-24): source tree plus a
# full git bundle. 1.1 GB. Never commit it - restore with
#   git clone "game-server/cstrike/Christmas Progress/git/freenova-classic-winterfest.bundle" .
game-server/cstrike/Christmas Progress/

# ── runtime state and player identity — never published ──────────────────────
# These were tracked before the repo was made public. They contain real players'
# SteamIDs, nicknames, bans and admin credentials. Untracked 2026-11-24; the files
# stay on disk. A fresh clone recreates them by running the server.
web-panel/data/
game-server/cstrike/addons/amxmodx/data/
game-server/cstrike/addons/amxmodx/logs/*.log
*.sq3
*.sq3-shm
*.sq3-wal
