/* Plugin generated by AMXX-Studio */

#include <amxmodx>
#include <amxmisc>

#define PLUGIN "Simple Knife Warump"
#define VERSION "1.0"
#define AUTHOR "Sn!ff3r"

#define TASKID 1234
#define DEFAULT_FREEZETIME 5

new hudtimer, cvar, hudhandler, mp_freezetime, value

public plugin_init() 
{
	register_plugin(PLUGIN, VERSION, AUTHOR)
		
	register_message(get_user_msgid("TextMsg") ,"message_TextMsg")	
	
	register_event("CurWeapon","switchweapon","be","1=1","2!29")
	register_clcmd("menuselect", "Cmd_BlockBuyMenu") 
	
	register_dictionary("simple_warmup.txt")
	
	cvar = register_cvar("warmup_timer", "60")
	register_cvar("amx_knife_round_active", "0")
	
	hudhandler = CreateHudSyncObj()
}

public plugin_cfg() 
{
	// Reset per-map state: a leaked "amx_knife_round_active 1" makes every XP
	// owner refuse to award XP for the whole map (REVIEW.md §5.5).
	set_cvar_num("amx_knife_round_active", 0)

	mp_freezetime = get_cvar_pointer("mp_freezetime")
	
	// Capture now, then again after server.cfg. Never keep a 0 snapshot:
	// if cfg has not applied yet, restoring 0 would disable freeze forever.
	read_vars()
	set_task(1.0, "read_vars")
}

public read_vars()
{
	if(!mp_freezetime)
		mp_freezetime = get_cvar_pointer("mp_freezetime")
	if(!mp_freezetime)
		return
	
	new iSnap = get_pcvar_num(mp_freezetime)
	if(iSnap > 0)
		value = iSnap
}

public message_TextMsg(const MsgId, const MsgDest, const MsgEntity)
{	
	static message[64]
	get_msg_arg_string(2, message, charsmax(message))
	
	if(equal(message, "#Game_Commencing"))
	{
		hudtimer = get_pcvar_num(cvar)
		
		if(hudtimer == -1)
			return

		read_vars()
		
		set_cvar_num("amx_knife_round_active", 1)
		
		formatex(message, charsmax(message), "%L", LANG_PLAYER, "WARMUP_START")	
		set_msg_arg_string(2, message)
		
		set_task(1.0, "restart", TASKID, _, _, "b")		
		set_pcvar_num(mp_freezetime, 0)		
	}
	if(equal(message, "#Game_will_restart_in"))
	{
		formatex(message, charsmax(message), "%L", LANG_PLAYER, "WARMUP_END")	
		set_msg_arg_string(2, message)
	}
}

// Undoes the two server-wide cvars the warm-up overrides. They outlive the map
// and only restart() ever put them back, so a map change mid-warm-up left
// amx_knife_round_active 1 (every XP owner gates on it, i.e. nobody earns XP on
// the next map) and mp_freezetime pinned at 0 (so the next map's snapshot reads
// 0 and falls back to DEFAULT_FREEZETIME). REVIEW.md §5.5.
stock RestoreWarmupCvars()
{
	set_pcvar_num(mp_freezetime, (value > 0) ? value : DEFAULT_FREEZETIME)
	set_cvar_num("amx_knife_round_active", 0)
}

public plugin_end()
{
	// Only when a warm-up is actually in flight - otherwise restart() already
	// restored these and there is nothing to undo.
	if(task_exists(TASKID))
	{
		remove_task(TASKID)
		RestoreWarmupCvars()
	}
}

public restart()
{			
	if(hudtimer <= 0)
	{
		remove_task(TASKID)
		set_cvar_num("sv_restartround", 1)
		RestoreWarmupCvars()
	} 
	else 
	{
		set_hudmessage(255,255,255,-1.0,0.9,0,6.0,1.0,0.1,0.2)	
		ShowSyncHudMsg(0, hudhandler, "%L", LANG_PLAYER, "COUNTING", hudtimer)
	}	
	hudtimer--
}

public switchweapon(id)
{
	if(task_exists(TASKID)) 
	{
		engclient_cmd(id, "weapon_knife")
	}
}

public Cmd_BlockBuyMenu(id)
{
	if(!task_exists(TASKID) || !is_user_alive(id))
		return PLUGIN_CONTINUE
	new oldmenu, newmenu
	player_menu_info(id, oldmenu, newmenu)
	if(newmenu != -1)
		return PLUGIN_CONTINUE
	return PLUGIN_HANDLED
}
